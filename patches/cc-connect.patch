+						token = "fixture-stale-token"
+					}
+					writeJSON(t, w, map[string]any{"code": 0, "expire": 7200, "tenant_access_token": token})
+				case r.Method == http.MethodPatch && r.URL.Path == "/open-apis/im/v1/messages/om_exact_source":
