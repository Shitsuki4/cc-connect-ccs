+// patchCommandCard targets the exact callback message, not the most recent
+// message for a session (two open menus must never overwrite each other).
+func (p *interactivePlatform) patchCommandCard(ctx context.Context, messageID, content string) error {
+	req := larkim.NewPatchMessageReqBuilder().MessageId(messageID).
+		Body(larkim.NewPatchMessageReqBodyBuilder().Content(content).Build()).Build()
+	return p.withTransientRetry(ctx, "update command card", func() error {
+		return p.withFreshTenantAccessTokenRetry(ctx, "update command card", func(client *lark.Client, options ...larkcore.RequestOptionFunc) error {
+			resp, err := client.Im.Message.Patch(ctx, req, options...)
+			if err != nil {
+				return fmt.Errorf("%s: update command card: %w", p.tag(), err)
+			}
+			if !resp.Success() {
+				return fmt.Errorf("%s: update command card code=%d", p.tag(), resp.Code)
+			}
