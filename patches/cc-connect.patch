+func TestReplyCard_InPlaceTargetsSourceAndFallsBackWithoutReexecuting(t *testing.T) {
+	for _, mode := range []string{"success", "patch-error", "token-refresh"} {
+		t.Run(mode, func(t *testing.T) {
