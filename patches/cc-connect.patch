+// commandCardReply hands the engine's authorized response back to the exact
+// Feishu callback that requested it. An unbuffered channel makes timeout vs.
+// delivery exclusive: a late response must fall back to PATCH, never disappear
+// into an unread buffered channel. done also releases any subsequent replies.
+type commandCardReply struct {
+	cards chan *core.Card
+	done  chan struct{}
+}
+
+func (r *commandCardReply) deliver(ctx context.Context, card *core.Card) bool {
+	select {
+	case r.cards <- card:
+		return true
+	case <-r.done:
+		return false
+	case <-ctx.Done():
+		return false
+	}
+}
+
+func (r *commandCardReply) response(sessionKey string) *callback.CardActionTriggerResponse {
+	timer := time.NewTimer(cardNavTimeout)
+	defer timer.Stop()
+	select {
+	case card := <-r.cards:
+		return &callback.CardActionTriggerResponse{
+			Card: &callback.Card{Type: "raw", Data: renderCardMap(card, sessionKey)},
+		}
+	case <-timer.C:
+		// The callback deadline is shorter than some provider/lookup requests.
+		// Closing done in the caller lets the eventual ReplyCard PATCH once.
+		return &callback.CardActionTriggerResponse{
+			Toast: &callback.Toast{Type: "info", Content: "⏳ Loading... / 加载中..."},
+		}
+	}
+}
