+					Buttons(core.DefaultBtn("Cancel", "cmd:/ccs pick token cancel")).
+					ListItemBtn("An item", "Refresh", "default", "cmd:/ccs").Build()
+				card.UpdateOnAction = inPlace
+				var result any
