+			actionCount++
+			engine.ReceiveMessage(platform, &Message{
+				SessionKey: "test:catalog-user", UserID: "catalog-user", Platform: "test",
+				MessageID: fmt.Sprintf("catalog-action-%d", actionCount), Content: content, ReplyCtx: "ctx",
+			})
+		}
+		tap := func(action string) {
+			test.Helper()
+			send(ccsCardCommand(test, lastCCSCard(test, platform.stubCardPlatform), action))
+		}
+		send("/ccs")
+		tap("provider:1")
+		if len(ccsCardSelect(test, lastCCSCard(test, platform.stubCardPlatform)).Options) != 2 {
+			test.Fatal("initial desktop catalog is missing models")
+		}
+		expectedModels := []string{"model-b"}
+		for index := range 121 {
+			expectedModels = append(expectedModels, fmt.Sprintf("vendor/catalog-model-%03d", index))
+		}
+		fixture.change(func(catalog *ProviderCatalog) {
+			catalog.Providers[1].Models = expectedModels
+		})
+		send("/ccs")
+		tap("provider:1")
+		seenModels := 0
+		for seenModels < len(expectedModels) {
+			options := ccsCardSelect(test, lastCCSCard(test, platform.stubCardPlatform)).Options
+			if len(options) != min(ccsPickerPageSize, len(expectedModels)-seenModels) {
+				test.Fatalf("incomplete model page after %d models: %d options", seenModels, len(options))
+			}
+			for _, option := range options {
+				if option.Text != expectedModels[seenModels] {
+					test.Fatalf("model %d = %q, want %q", seenModels, option.Text, expectedModels[seenModels])
+				}
+				seenModels++
+			}
+			if seenModels < len(expectedModels) {
+				tap("next")
+			}
+		}
+		tap(fmt.Sprintf("model:%d", len(expectedModels)-1))
+		preview := lastCCSCard(test, platform.stubCardPlatform).RenderText()
+		if !strings.Contains(preview, expectedModels[len(expectedModels)-1]) {
+			test.Fatal("last catalog model is missing from the confirmation preview: ", preview)
+		}
+		tap("cancel")
+		if fixture.posts.Load() != 0 || modelSaves != 0 || agent.GetModel() != "model-a" {
+			test.Fatal("browsing the refreshed catalog changed a provider or model")
+		}
+	})
+	t.Log("CUJ-F2: other model switching is covered by agent/*_test.go model tests")
 }
 
